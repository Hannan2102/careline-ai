# =============================================================================
# agentic-patient-access / CareLine AI  --  example environment
# Copy to .env and fill in ONLY what you need. Never commit .env.
# Defaults below are SAFE: text-only, no paid API calls are possible.
# =============================================================================

APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Persistence -------------------------------------------------------------
# Application database (sessions, audit, escalations, provider usage).
# Postgres via docker compose:
DATABASE_URL=postgresql+asyncpg://careline:careline@localhost:5432/careline
# No Docker? A local SQLite file works for everything except the HAPI FHIR server:
# DATABASE_URL=sqlite+aiosqlite:///./careline.db

# --- EHR ---------------------------------------------------------------------
# local  -> HAPI FHIR R4 server (docker compose)
# memory -> in-process synthetic FHIR store; no Docker required (tests + laptop dev)
# epic   -> Epic sandbox adapter (future, Phase 16)
EHR_PROVIDER=memory
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_TIMEOUT_SECONDS=10

# --- AI mode -----------------------------------------------------------------
# cloud -> OpenAI / Deepgram / ElevenLabs
# local -> Ollama / faster-whisper / Piper   (Phase 17, interfaces only for now)
# mock  -> deterministic scripted providers; zero cost; used by the test suite
AI_MODE=mock
# Let the model classify what the caller wants, with the keyword rules as the
# floor beneath it. No effect in mock mode. Turn off to run rules-only.
LLM_EXTRACTION_ENABLED=true

LLM_PROVIDER=mock          # mock | openai | ollama
STT_PROVIDER=mock          # mock | deepgram | whisper
TTS_PROVIDER=mock          # mock | groq | deepgram | elevenlabs | piper

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Groq: OpenAI-compatible wire format on a free, rate-limited developer tier.
# Served by the same adapter with a different base URL. Set LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq also serves speech synthesis, on the same key and the same free tier.
# Measured at ~400 ms to first audio against ElevenLabs Flash's ~75-150 ms --
# slower, and free, which is the trade this project takes (COSTS.md).
# Voices: autumn diana hannah austin daniel troy
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Aura names the voice as the model. Uses the same key and credit as
# recognition above, and is metered per character rather than capped per day.
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Synthesise over the websocket (3.5x faster to first audio). false = REST.
DEEPGRAM_TTS_STREAMING=true

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- Realtime voice transport (Phase 13+) ------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Telephony (Phase 15, opt-in only) ---------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Where this service is reachable from the internet. Twilio dials the stream
# URL from outside, and it is half of the webhook signature, so a wrong value
# fails closed. In development this is an ngrok/cloudflared URL.
PUBLIC_BASE_URL=
TWILIO_PHONE_NUMBER=

# --- Mode switches -----------------------------------------------------------
# TEXT_ONLY_MODE=true hard-disables STT/TTS/voice transport regardless of the
# flags below. This is the default and keeps development cost at $0.
TEXT_ONLY_MODE=true
VOICE_ENABLED=false
STT_ENABLED=false
TTS_ENABLED=false

# --- Budget controls (see COSTS.md) ------------------------------------------
MAX_ESTIMATED_PROJECT_COST_USD=20
WARN_ESTIMATED_PROJECT_COST_USD=15
MAX_ESTIMATED_SESSION_COST_USD=1
MAX_LLM_OUTPUT_TOKENS=400
MAX_CONVERSATION_TURNS=20
MAX_TTS_CHARACTERS_PER_SESSION=3000
MAX_STT_MINUTES_PER_SESSION=10
# Escape hatch for deliberate, supervised demos. Never set this in CI.
BUDGET_GUARD_OVERRIDE=false

# --- Frontend ----------------------------------------------------------------
# Read by the dashboard in the browser (frontend/.env.local, or exported here).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Browser origins the API accepts cross-origin requests from. JSON list; never "*".
# DASHBOARD_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
